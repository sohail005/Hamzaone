# Origin the frontend calls for /api/* requests. The API now lives in this
# same app (app/api/*), so in production this is the app's own deployed URL
# (e.g. https://hamzaone.store). For local development, point it at your
# local origin instead so requests don't leave your machine:
#   next dev      -> http://localhost:3000
#   npm run cf:preview -> http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=

# NimbusPost (https://nimbuspost.com/) — used for delivery-time estimation
# Create an account, then find/generate API credentials in Settings > API.
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=
# The pincode your shipments are picked up from (your warehouse/store pincode).
NIMBUSPOST_PICKUP_PINCODE=

# Razorpay test credentials (the secret must never use a NEXT_PUBLIC_ prefix).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# "Sign in with Google" — create an OAuth client at
# https://console.cloud.google.com/apis/credentials (Application type: Web
# application). Add this exact redirect URI there:
#   <NEXT_PUBLIC_API_URL>/api/auth/google/callback
# e.g. https://hamzaone.store/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated email allowlist. Any account that registers, logs in, or
# signs in with Google using one of these emails is promoted to the "admin"
# role automatically — this is the only way to get admin access, since there
# is no manual role-promotion UI.
ADMIN_EMAILS=
